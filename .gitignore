# CON-6: runs/ is gitignored (keep the directory itself)
runs/*
!runs/.gitkeep

__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/
.DS_Store
out/

# `dora graph <graph>.yaml` renders a mermaid visualization to
# <stem>-graph.html in the CWD. Useful while reading a dataflow, never an
# input to one: it is derived from graphs/, so committing it would be a
# second copy of the topology that silently goes stale.
*-graph.html

# ADR-67: receipt of the locally built Nexus wheel (tools/nexus_runtime.py)
.nexus-runtime-receipt.json
# ADR-68: receipt of the locally built rapier wheel (tools/rapier_runtime.py)
.rapier-runtime-receipt.json

# ADR-67/ADR-68: pinned engine checkouts fetched by tools/engine_sources.py
.engine-sources/
# ADR-g1-driver: receipt of the out-of-lock Unitree SDK2 install (tools/g1_runtime.py)
.g1-runtime-receipt.json
